# Credentials for the teams-bot connector (see README's setup checklist).
# Copy to .env and fill in from your Azure Bot resource. .env is gitignored.
#
# Leave these unset to run the connector unauthenticated for the local
# harness (scripts/bot-activity-harness.mjs) — never with a tunnel in front.

WATCHER_CONNECTOR=teams-bot

MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# "MultiTenant" (default), "SingleTenant", or "UserAssignedMSI".
MICROSOFT_APP_TYPE=MultiTenant
# Required only for SingleTenant.
MICROSOFT_APP_TENANT_ID=

# Local port the bot's activity listener binds to (loopback only).
WATCHER_BOT_PORT=3978
