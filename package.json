{
  "name": "teams-message-research",
  "version": "0.1.0",
  "private": true,
  "description": "Local browser-automation watcher for Microsoft Teams conversations, with edit/delete history and a multi-tab dashboard.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "node scripts/free-port.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "predev": "node scripts/free-port.mjs",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "free-port": "node scripts/free-port.mjs",
    "clone-debug-data": "node scripts/clone-debug-data.mjs",
    "build-teams-app": "node scripts/build-teams-app.mjs",
    "bot-harness": "node scripts/bot-activity-harness.mjs"
  },
  "dependencies": {
    "botbuilder": "^4.23.3",
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
